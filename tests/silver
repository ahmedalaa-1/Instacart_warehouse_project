-- ============================================================
-- CHECK AISLES TABLE QUALITY
-- ============================================================

SELECT COUNT(*), aisle_id
FROM silver.aisles
GROUP BY aisle_id
HAVING COUNT(*) > 1;

SELECT aisle_id
FROM silver.aisles
WHERE aisle_id <= 0 OR aisle_id IS NULL;

SELECT aisle
FROM silver.aisles
WHERE aisle <> TRIM(aisle);

SELECT aisle
FROM silver.aisles
WHERE aisle = '' OR aisle = ' ';


