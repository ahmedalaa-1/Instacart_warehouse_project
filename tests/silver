-- ============================================================
-- CHECK ORDERS TABLE QUALITY
-- ============================================================

SELECT COUNT(*), order_id, user_id
FROM silver.orders
GROUP BY order_id, user_id
HAVING COUNT(*) > 1;

SELECT COUNT(*), order_id, user_id, order_number
FROM silver.orders
GROUP BY order_id, user_id, order_number
HAVING COUNT(*) > 1;

SELECT COUNT(*), order_id
FROM silver.orders
GROUP BY order_id
HAVING COUNT(*) > 1;

SELECT order_id
FROM silver.orders
WHERE order_id <= 0 OR order_id IS NULL;

SELECT user_id
FROM silver.orders
WHERE user_id <= 0 OR user_id IS NULL;

SELECT eval_set
FROM silver.orders
WHERE eval_set NOT IN ('prior', 'train', 'test');

SELECT order_number
FROM silver.orders
WHERE order_number <= 0;

SELECT order_dow
FROM silver.orders
WHERE order_dow NOT BETWEEN 0 AND 6;

SELECT order_hour_of_day
FROM silver.orders
WHERE order_hour_of_day NOT BETWEEN 0 AND 23;

SELECT days_since_prior_order
FROM silver.orders
WHERE days_since_prior_order < 0;


