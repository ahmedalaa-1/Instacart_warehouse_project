-- ============================================================
-- CHECK RELATIONSHIPS
-- ============================================================

SELECT p.product_id, p.aisle_id
FROM silver.products p
LEFT JOIN silver.aisles a
    ON p.aisle_id = a.aisle_id
WHERE p.aisle_id IS NOT NULL
  AND a.aisle_id IS NULL;

SELECT p.product_id, p.department_id
FROM silver.products p
LEFT JOIN silver.departments d
    ON p.department_id = d.department_id
WHERE p.department_id IS NOT NULL
  AND d.department_id IS NULL;

SELECT op.order_id
FROM silver.order_products_prior op
LEFT JOIN silver.orders o
    ON op.order_id = o.order_id
WHERE op.order_id IS NOT NULL
  AND o.order_id IS NULL;

SELECT op.order_id, op.product_id
FROM silver.order_products_prior op
LEFT JOIN silver.products p
    ON op.product_id = p.product_id
WHERE op.product_id IS NOT NULL
  AND p.product_id IS NULL;

SELECT op.order_id
FROM silver.order_products_train op
LEFT JOIN silver.orders o
    ON op.order_id = o.order_id
WHERE op.order_id IS NOT NULL
  AND o.order_id IS NULL;

SELECT op.order_id, op.product_id
FROM silver.order_products_train op
LEFT JOIN silver.products p
    ON op.product_id = p.product_id
WHERE op.product_id IS NOT NULL
  AND p.product_id IS NULL;
